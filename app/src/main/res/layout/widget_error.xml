<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:padding="16dp" android:background="#E8E4D0">
    <TextView android:id="@+id/widget_error_message" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:text="@string/widget_error" android:textColor="#2E2A1E" android:textSize="16sp" />
    <TextView android:id="@+id/widget_error_action" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:minHeight="48dp" android:gravity="center_vertical"
        android:text="@string/widget_choose" android:textColor="#2E2A1E" android:textSize="16sp" />
</LinearLayout>

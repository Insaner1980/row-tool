<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="8dp"
    android:background="#E8E4D0"
    tools:ignore="Overdraw">
    <!-- Launcher-hosted RemoteViews keeps the edit icon as a separate accessible view. -->
    <LinearLayout android:layout_width="match_parent" android:layout_height="48dp" android:orientation="horizontal" tools:ignore="UseCompoundDrawables">
        <TextView android:layout_width="0dp" android:layout_weight="1" android:layout_height="48dp"
            android:text="@string/widget_preview_project" android:maxLines="1" android:textColor="#2E2A1E" android:textSize="14sp" />
        <!-- Inflated by the launcher as RemoteViews: AppCompat app:tint is not supported here. -->
        <ImageView tools:ignore="UseAppTint" android:layout_width="48dp" android:layout_height="48dp" android:padding="12dp"
            android:src="@drawable/ic_edit" android:tint="#2E2A1E" android:contentDescription="@string/widget_choose" />
    </LinearLayout>
    <TextView android:layout_width="match_parent" android:gravity="center" android:layout_height="64dp"
        android:text="@string/widget_preview_count" android:textColor="#2E2A1E" android:textSize="26sp" />
    <TextView android:layout_width="match_parent" android:gravity="center" android:layout_height="32dp"
        android:text="@string/project_rows" android:textColor="#2E2A1E" android:textSize="12sp" />
    <TextView android:layout_width="match_parent" android:layout_height="56dp" android:layout_marginTop="48dp" android:gravity="center"
        android:text="@string/widget_preview_controls" android:textColor="#2E2A1E" android:textSize="24sp" />
</LinearLayout>
